# AI Assessment Engine Environment Variables

# Application
APP_NAME=CORTEXIA AI Assessment Engine
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Database
DATABASE_URL=postgresql://cortexia_user:cortexia_password@localhost:5432/cortexia_db
MONGODB_URL=mongodb://localhost:27017/cortexia_analytics
REDIS_URL=redis://localhost:6379/0

# Model Paths
MODEL_DIR=./models
GAZE_MODEL_PATH=./models/gaze_classifier.joblib
SPEECH_MODEL_PATH=./models/speech_classifier.joblib
MULTIMODAL_MODEL_PATH=./models/multimodal_classifier.joblib
SCALER_PATH=./models/scaler.joblib

# Model Configuration
CONFIDENCE_THRESHOLD=0.7
MIN_GAZE_POINTS=100
MIN_SPEECH_DURATION=10

# API Keys (if needed for external services)
# OPENAI_API_KEY=your_openai_key_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/ai_engine.log

# Backend API
BACKEND_API_URL=http://localhost:5000/api
