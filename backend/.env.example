# Application
NODE_ENV=development
PORT=5000
APP_NAME=CORTEXIA
APP_URL=http://localhost:5000

# Database - PostgreSQL
DATABASE_URL=postgresql://cortexia_user:cortexia_password@localhost:5432/cortexia_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cortexia_db
DB_USER=cortexia_user
DB_PASSWORD=cortexia_password

# MongoDB - Analytics
MONGODB_URL=mongodb://cortexia_admin:cortexia_mongo_password@localhost:27017/cortexia_analytics
MONGODB_DB_NAME=cortexia_analytics

# Redis - Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=audio/wav,audio/mp3,audio/mpeg,image/jpeg,image/png

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=ai-service-api-key

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@cortexia.id

# Storage (S3 or Local)
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=cortexia-uploads

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=your-session-secret-change-this

# WebSocket
WS_PING_TIMEOUT=60000
WS_PING_INTERVAL=25000

# Assessment Settings
MIN_CALIBRATION_ACCURACY=75
ASSESSMENT_TIMEOUT_MINUTES=30
GAZE_SAMPLING_RATE_MS=100

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# Development
DEBUG=cortexia:*
